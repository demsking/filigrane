#: data/io.gitlab.demsking.filigrane.desktop.in:3
#: data/io.gitlab.demsking.filigrane.metainfo.xml.in:8
msgid "Add text or image watermarks to PDF documents"
msgstr "Ajoutez des filigranes de texte ou d'image aux documents PDF"

#: data/io.gitlab.demsking.filigrane.desktop.in:10
msgid "PDF;Watermark;Filigrane;Stamp;Sign;Security;"
msgstr "PDF;Filigrane;Tampon;Signature;Sécurité;"

#: data/io.gitlab.demsking.filigrane.metainfo.xml.in:11
msgid ""
"Filigrane is a modern application designed to apply elegant vector text or "
"high-resolution image watermarks to PDF documents quickly and securely."
msgstr ""
"Filigrane est une application moderne conçue pour appliquer rapidement et en "
"toute sécurité des filigranes de texte vectoriel élégants ou d'images haute "
"résolution aux documents PDF."

#: data/io.gitlab.demsking.filigrane.metainfo.xml.in:14
msgid "Features include:"
msgstr "Les fonctionnalités incluent :"

#: data/io.gitlab.demsking.filigrane.metainfo.xml.in:16
msgid ""
"Support for custom text watermarks with font selection, opacity, rotation, "
"and alignment"
msgstr ""
"Prise en charge de filigranes de texte personnalisés avec sélection de la "
"police, de l'opacité, de la rotation et de l'alignement"

#: data/io.gitlab.demsking.filigrane.metainfo.xml.in:17
msgid ""
"Support for PNG, SVG, and JPEG image watermarks with scale and aspect ratio "
"options"
msgstr ""
"Prise en charge de filigranes d'images PNG, SVG et JPEG avec options d'échelle "
"et de proportions"

#: data/io.gitlab.demsking.filigrane.metainfo.xml.in:18
msgid ""
"Multiple placement modes including Center, Corners, Tiled patterns, and "
"custom X/Y positioning"
msgstr ""
"Plusieurs modes de placement, y compris le centre, les coins, les motifs en "
"mosaïque et le positionnement X/Y personnalisé"

#: data/io.gitlab.demsking.filigrane.metainfo.xml.in:19
msgid "Real-time live document preview powered by Poppler"
msgstr "Aperçu du document en direct et en temps réel propulsé par Poppler"

#: data/io.gitlab.demsking.filigrane.metainfo.xml.in:20
msgid ""
"Full integration with GNOME Files, recent documents, and native GTK4/"
"Libadwaita portal dialogs"
msgstr ""
"Intégration complète avec Fichiers GNOME, les documents récents et les "
"dialogues de portail natifs GTK4/Libadwaita"

#: data/io.gitlab.demsking.filigrane.metainfo.xml.in:29
msgid "Main application interface"
msgstr "Interface principale de l'application"

#: data/io.gitlab.demsking.filigrane.metainfo.xml.in:33
msgid "Main application interface with text watermark"
msgstr "Interface principale de l'application avec filigrane de texte"

